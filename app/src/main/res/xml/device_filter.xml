<?xml version="1.0" encoding="utf-8"?>
<!--
    Match common USB-serial bridge chips used on KFD Shield and KFD Tool hardware.
    Arduino CDC-ACM: VID 0x2341
    FTDI FT232:      VID 0x0403
    CP2102/CP2104:   VID 0x10C4
    CH340/CH341:     VID 0x1A86
    Prolific PL2303: VID 0x067B
-->
<resources>
    <!-- Arduino Uno / KFD Shield (CDC ACM) -->
    <usb-device vendor-id="9025" />

    <!-- FTDI FT232 -->
    <usb-device vendor-id="1027" />

    <!-- Silicon Labs CP210x -->
    <usb-device vendor-id="4292" />

    <!-- CH340 / CH341 -->
    <usb-device vendor-id="6790" />

    <!-- Prolific PL2303 -->
    <usb-device vendor-id="1659" />

    <!-- Motorola APX Series Radio / Control Head (RNDIS DLI) — VID 0x0CAD (3245).
         Match by Communications device class (2) so any current or future APX model
         is auto-recognized without a device-filter update. Confirmed PIDs so far:
           0x101B (mobile control head), 0x1051 (portable radio), 0x1052 (portable radio).
         Non-RNDIS Motorola devices matching this filter still fail cleanly at open time
         since our RNDIS manager validates the interface layout before proceeding. -->
    <usb-device vendor-id="3245" class="2" />
</resources>
