<?xml version="1.0" encoding="utf-8"?>
<!--
    Match common USB-serial bridge chips used on KFD Shield and KFD Tool hardware.
    Arduino CDC-ACM: VID 0x2341
    FTDI FT232:      VID 0x0403
    CP2102/CP2104:   VID 0x10C4
    CH340/CH341:     VID 0x1A86
    Prolific PL2303: VID 0x067B
-->
<resources>
    <!-- Arduino Uno / KFD Shield (CDC ACM) -->
    <usb-device vendor-id="9025" />

    <!-- FTDI FT232 -->
    <usb-device vendor-id="1027" />

    <!-- Silicon Labs CP210x -->
    <usb-device vendor-id="4292" />

    <!-- CH340 / CH341 -->
    <usb-device vendor-id="6790" />

    <!-- Prolific PL2303 -->
    <usb-device vendor-id="1659" />
</resources>
